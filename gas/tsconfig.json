{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "esnext",
    "types": ["google-apps-script"],
    "lib": ["esnext", "dom"],

    "experimentalDecorators": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist", "scripts"]
}
